{
  "builds": [
    {
      "src": "my-app/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "my-app/dist/**",
          "my-app/src/audio/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "my-app/api/index.js"
    },
    {
      "src": "/audio/(.*)",
      "dest": "my-app/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "my-app/api/index.js"
    }
  ]
}