{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "sourceMap": true,
    "module": "es6",
    "target": "es5",
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "node",
    "strict": true,            // Разрешает импорт JavaScript
    "checkJs": false,           // (Опционально) не проверять ошибки внутри JS
    "esModuleInterop": true
  },
  "files": ["global.d.ts"],
   "include": ["./src/**/*"]
}
