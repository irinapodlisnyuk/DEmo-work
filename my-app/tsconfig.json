{
  "compilerOptions": {
    "types": ["node", "jest"],
    "outDir": "./dist/",
    "noImplicitAny": true,
    "sourceMap": true,
    "jsx": "react",
    "allowJs": true,
    "strict": true,
    "checkJs": false,
    "esModuleInterop": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "files": ["global.d.ts"],
  "include": ["./src/**/*"]
}
