{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/audio/(.*)",
      "dest": "src/audio/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}